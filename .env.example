# ---- Railway → Variables. All read at RUNTIME (no rebuild needed, just a restart). ----

# Treasury wallet (Solana). Test value = Coinbase Hot Wallet 2 (live, lots of tokens).
TREASURY_WALLET=GJRs4FwHtemZ5ZE9x3FNvJ8TMwitKTh21yxdRPqn7npE

# Solana RPC. Strongly recommended: free Helius key (https://dev.helius.xyz) — public RPC is rate-limited.
HELIUS_API_KEY=
# Or any other RPC URL (overrides HELIUS_API_KEY for RPC calls):
RPC_URL=

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random long string. Keeps chat sessions valid across restarts. e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- branding / links (all optional) ----
PROJECT_NAME=fomo family
TAGLINE=where the family never misses out.
TOKEN_TICKER=$FOMO
TOKEN_MINT=
STONK_URL=
X_URL=
TELEGRAM_URL=

# ---- portfolio tuning (optional) ----
TREASURY_START_USD=0
COST_BASIS_JSON={}
WATCH_MINTS=
MIN_POSITION_USD=1
MAX_POSITIONS=24
TREASURY_REFRESH_SECONDS=45

# ---- chat extras (optional) ----
# Pinned message at the top of the chat
ANNOUNCEMENT=
# Comma-separated wallets that can delete chat messages
ADMIN_WALLETS=
# Post "the fund bought X" alerts into the chat when the treasury swaps (needs HELIUS_API_KEY)
TRADE_ALERTS=true

# ---- chat gate (optional): only holders of TOKEN_MINT may chat ----
CHAT_HOLDERS_ONLY=false
MIN_TOKEN_BALANCE=0

PORT=3000
